{
    "name": "nmbrthirteen/storage-inspector",
    "description": "Inspect WordPress storage usage by plugin, media, theme, cache, backups, logs, and generated files.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Nika Siradze",
            "homepage": "https://nikusha.com"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "autoload": {
        "psr-4": {
            "StorageInspector\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
